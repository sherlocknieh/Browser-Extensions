{
  "name": "qrcode",
  "version": "1.3.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "submit:firefox": "wxt zip -b firefox --mv3 && wxt submit --firefox-zip .output/*-firefox.zip --firefox-sources-zip .output/*-sources.zip",
    "submit:edge": "wxt zip && wxt submit --edge-zip .output/*-chrome.zip",
    "submit:chrome": "wxt zip && wxt submit --chrome-zip .output/*-chrome.zip",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "js-web-screen-shot": "1.9.9-rc.29",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "sweetalert2": "^11.26.18",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.4",
    "web-ext": "^10.8.0",
    "wxt": "0.21.4"
  }
}